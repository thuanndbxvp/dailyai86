{
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.6.1"
        },
        "public/index.php": {
            "runtime": "vercel-php@0.6.1"
        }
    },
    "routes": [
        {
            "src": "^/public/(.*)",
            "dest": "/public/$1"
        },
        {
            "src": "^/(.*)",
            "dest": "/public/index.php"
        }
    ]
}
